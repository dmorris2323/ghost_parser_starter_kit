
import io, pandas as pd, streamlit as st
from ghost_parser import parse_lines, load_aois

st.set_page_config(page_title="Ghost Parser GUI", layout="wide")
st.title("🛰️ Ghost Parser — GUI v0.1")

left, right = st.columns(2)
with left:
    raw_file = st.file_uploader("Raw log", type=["log","txt"])
    raw_text = st.text_area("...or paste lines", height=160)
with right:
    aoi_file = st.file_uploader("AOI (aoi.json) [optional]", type=["json"])
    max_depth_km = st.number_input("Max depth (km)", value=2.5, step=0.1)
    min_mag      = st.number_input("Min magnitude", value=3.5, step=0.1)
    max_mag      = st.number_input("Max magnitude", value=6.5, step=0.1)

lines = []
if raw_file:
    lines = raw_file.read().decode("utf-8", errors="ignore").splitlines()
elif raw_text.strip():
    lines = raw_text.splitlines()

aois = {}
if aoi_file:
    try:
        aois = load_aois(aoi_file.read().decode("utf-8"))
        st.success("AOIs loaded successfully ✅")
    except Exception as e:
        st.error(f"AOI load error: {e}")

if st.button("🚀 Parse Data", type="primary", use_container_width=True):
    if not lines:
        st.warning("No input lines detected.")
    else:
        rows, flagged = parse_lines(lines, aois, max_depth_km=max_depth_km, min_mag=min_mag, max_mag=max_mag)
        df = pd.DataFrame(rows)
        st.metric("Parsed events", len(df))
        st.metric("Flagged", int(df["Flagged"].sum()))
        st.dataframe(df, use_container_width=True, hide_index=True)

        csv_data = df.to_csv(index=False).encode("utf-8")
        json_data = io.BytesIO()
        for _, r in df.iterrows():
            json_data.write((r.to_json() + "\n").encode("utf-8"))

        st.download_button("⬇️ Download CSV", csv_data, "parsed_gui.csv", "text/csv")
        st.download_button("⬇️ Download JSONL", json_data.getvalue(), "parsed_gui.jsonl", "application/json")

